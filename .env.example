# 复制为 .env；不要提交真实密钥。
WAYGENT_HTTP_PORT=8765
MYSQL_PASSWORD=waygent-demo-change-me
MYSQL_ROOT_PASSWORD=waygent-root-change-me
# 可留空，首次启动会在持久化 data 卷生成签名密钥；正式部署请设置随机长字符串。
JWT_SECRET=

# 支持 deepseek / doubao，填写所选服务的有效 Key。
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_HTTP_PROXY=
DOUBAO_API_KEY=
DOUBAO_MODEL=
# 可选：分别指定主 Agent 与规划相关任务的模型。
MAIN_AGENT_MODEL=
PLANNING_AGENT_MODEL=
PLANNING_CANDIDATE_MODEL=
PLANNING_SPOT_TIPS_MODEL=
CHAT_SUMMARY_MODEL=
MEMORY_EXTRACTION_MODEL=
PLANNING_MEMORY_MATCH_MODEL=

# 高德 Web 服务 Key：景点、天气与交通规划使用。
AMAP_API_KEY=
# 高德 Web端(JS API) Key 与安全密钥：前端地图使用。
AMAP_JS_KEY=
AMAP_JS_SECURITY_CODE=

# 单节点任务并发与截止时间。
RUNTIME_CHAT_CONCURRENCY=8
RUNTIME_PLANNING_CONCURRENCY=2
RUNTIME_PLANNING_PER_USER=2
RUNTIME_LLM_CONCURRENCY=8
RUNTIME_AMAP_CONCURRENCY=8
RUNTIME_REVISION_TIMEOUT_SECONDS=300
